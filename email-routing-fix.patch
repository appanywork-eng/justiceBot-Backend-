+/**
+ * ===== SURGICAL EMAIL ROUTING FIX (Nelson's Rule) =====
+ * Extract emails for institutions mentioned in petition body from sector JSON.
+ * Works for TO, THROUGH, or CC sections as long as the institution name appears in the body.
+ * Does NOT fallback to all sector contacts.
+ * Preserves all other logic, config, and endpoints.
+ */
+function getMentionedInstitutionEmails(petitionText = "", sectorJson = {}) {
+  const found = [];
+  const text = normalizeName(petitionText);
+
+  function collect(node) {
+    if (!node || typeof node !== "object") return;
+    const name = normalizeName(node.name || "");
+    if (name && text.includes(name) && Array.isArray(node.emails)) {
+      found.push(...node.emails);
+    }
+  }
+
+  if (Array.isArray(sectorJson.core_institutions)) sectorJson.core_institutions.forEach(collect);
+  if (Array.isArray(sectorJson.regulators)) sectorJson.regulators.forEach(collect);
+  if (Array.isArray(sectorJson.watchdogs)) sectorJson.watchdogs.forEach(collect);
+  if (Array.isArray(sectorJson.players)) sectorJson.players.forEach(collect);
+
+  const uniq = safeUniq(found).filter(isEmail).filter(isLikelyOfficialEmail);
+  return uniq.length ? uniq.slice(0, 10) : [];
+}
