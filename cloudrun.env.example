# Non-secret Cloud Run environment variables

FIRESTORE_ENABLED=true
FIRESTORE_COLLECTION=petitiondesk_runtime

FRONTEND_BASE_URL=https://petitiondesk.com
ALLOWED_ORIGINS=https://petitiondesk.com,https://www.petitiondesk.com

GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_TOTAL_TIMEOUT_MS=110000
GEMINI_MAX_RETRIES=1
AI_SECTOR_CLASSIFY=false

PETITION_PRICE_NGN=550
FREE_ACCESS_ENABLED=true
FREE_PETITION_LIMIT=2
PETITION_TTL_SECONDS=7200
ADMIN_SESSION_TTL_SECONDS=7200
ADMIN_LOGIN_RATE_LIMIT_MAX=8
GENERATION_RATE_LIMIT_MAX=12
SECURITY_RATE_LIMIT_WINDOW_MS=900000

FLW_TIMEOUT_MS=20000
VERIFY_PENDING_WINDOW_MS=900000

DEBUG_SECTOR=false
DEBUG_PAYMENT=false

PCC_EMAIL=
NHRC_EMAIL=
FCCPC_EMAIL=
SERVICOM_EMAIL=
AGF_EMAIL=

# Store the following in Google Secret Manager,
# not as ordinary environment variables:
#
# GOOGLE_API_KEY
# FLW_SECRET_KEY
# FLW_WEBHOOK_HASH
# ADMIN_UNLOCK_KEY
