+function stripCommonSuffixes(s = "") {
+  return String(s)
+    .replace(/\b(plc|ltd|limited|company|co|inc|inc\.|corporation|corp)\b/gi, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function makeAcronym(name = "") {
+  // "Abuja Electricity Distribution Company" -> "AEDC"
+  const cleaned = stripCommonSuffixes(name)
+    .replace(/[^a-zA-Z0-9\s]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+  if (!cleaned) return "";
+  const parts = cleaned.split(" ").filter(Boolean);
+  if (parts.length < 2) return "";
+  const acr = parts.map((p) => p[0]).join("").toUpperCase();
+  return acr.length >= 2 ? acr : "";
+}
+
+function buildNameVariants(name = "", obj = {}) {
+  const variants = new Set();
+  if (name) variants.add(String(name));
+
+  // Add stripped variant (removes Plc/Ltd etc)
+  const stripped = stripCommonSuffixes(name);
+  if (stripped && stripped !== name) variants.add(stripped);
+
+  // Add acronym
+  const acr = makeAcronym(name);
+  if (acr) variants.add(acr);
+
+  // If JSON has aliases, add them
+  if (obj && Array.isArray(obj.aliases)) {
+    obj.aliases.forEach((a) => {
+      if (a) variants.add(String(a));
+    });
+  }
+
+  // If JSON has short_name, add it
+  if (obj && obj.short_name) variants.add(String(obj.short_name));
+
+  return [...variants].filter(Boolean);
+}
