  "complaint_and_escalation_flow": {
    "step_1": "Report incident to the primary responsible agency (NPF/NIS/NCoS/NSCDC) in writing; request incident/reference number.",
    "step_2": "If misconduct/abuse of power is alleged, escalate to the supervising ministry and relevant oversight body (PSC for police personnel issues; internal complaint desks where published).",
    "step_3": "For human-rights-sensitive matters, copy National Human Rights Commission (NHRC) and legal aid/civil society support where relevant.",
    "step_4": "If unresolved and severe, use international escalation pathways (see international_escalation.json)."
  },
