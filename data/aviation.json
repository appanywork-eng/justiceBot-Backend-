  "routing_rules": {
    "ordinary_first_complaint": {
      "recipient": "Responsible airline or aviation service provider",
      "delivery": "Verified provider complaint email, contact page, customer affairs unit or airport service desk",
      "requirement": "The passenger should retain the complaint reference, ticket, booking reference and supporting evidence."
    },
    "unresolved_consumer_complaint": {
      "recipient": "Nigerian Civil Aviation Authority (NCAA)",
      "delivery": "NCAA Consumer Protection complaint portal, email or airport complaint desk",
      "also_notify": "Responsible airline or aviation service provider",
      "requirement": "Include evidence that the provider was first given an opportunity to resolve the complaint."
    },
    "accident_or_serious_incident": {
      "recipient": "Nigerian Safety Investigation Bureau (NSIB)",
      "delivery": "Immediate emergency telephone notification followed by the official secure reporting portal",
      "requirement": "Report accidents and serious incidents without delay. Active emergencies should also be reported to emergency services."
    },
    "restricted_routes": [
      "The supervising ministry is not the ordinary first-stage recipient for passenger complaints.",
      "NCAA Consumer Protection is not a replacement for first complaining to the airline or service provider.",
      "NSIB is for accidents and serious safety occurrences, not ordinary refunds, delays or baggage disputes.",
      "Inactive or unverified airline contact details must not be exposed."
    ],
    "verified_live_metadata": "Live routing exposes only officially verified airline, NCAA and NSIB emails, telephone numbers, portals, addresses and source URLs.",
    "unknown_airline": "Where an airline is user-supplied but not present in the verified registry, generate the provider-first complaint without exposing or guessing any contact address.",
    "ncaa_escalation": "Unresolved passenger complaints route to NCAA Consumer Protection through its verified email and official complaint portal.",
    "nsib_safety": "Aircraft accidents and serious incidents bypass ordinary consumer escalation and route immediately to NSIB reporting and emergency channels."
  },
