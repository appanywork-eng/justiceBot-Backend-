  "routing_policy": {
    "specialist_sector_first": "Use general administration only when no specialist sector provides a more appropriate regulator or complaint mechanism.",
    "internal_first": "Where a responsible institution has an internal complaint, grievance or SERVICOM unit, the complainant should ordinarily lodge and document that complaint before external escalation.",
    "default_primary": "The Public Complaints Commission is the primary national route for general administrative injustice.",
    "state_location": "Use the official PCC state-office directory for location-specific routing. Do not construct or guess state-office email addresses.",
    "public_service": "Include SERVICOM only where the complaint concerns delay, refusal, poor quality or failure in public-service delivery.",
    "consumer_service": "Include FCCPC only where the complaint concerns goods, paid services, unfair charges, failed delivery, refused refunds or related consumer redress.",
    "human_rights": "Include NHRC only where the facts disclose a credible human-rights concern.",
    "recipient_limit": "Copy only institutions whose legal or administrative mandate is clearly raised by the complaint.",
    "civil_disputes": "Private civil disputes and state ADR matters must be handled under the civil-disputes sector rather than general administration."
  },
