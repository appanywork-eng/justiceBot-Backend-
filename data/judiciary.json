  "evidence_checklist": [
    "Full case title and suit, charge or appeal number",
    "Court name, judicial division and location",
    "Names or official titles of judicial or registry officers involved",
    "Chronology of filing, hearing, adjournment, ruling and judgment dates",
    "Copies of relevant court processes, orders and judgments",
    "Receipts for filing, certified copies, service or enforcement",
    "Previous complaint acknowledgement or reference number",
    "Correspondence with the registry, court or legal practitioner",
    "Details of money, documents or client property held by a lawyer",
    "Witness statements or supporting affidavits where required",
    "Evidence of detention, denied access to counsel or disobedience of an order",
    "The specific administrative or disciplinary remedy requested"
  ],
