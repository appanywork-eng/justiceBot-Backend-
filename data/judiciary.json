  "routing_policy": {
    "judicial_misconduct": "Complaints alleging misconduct by a judicial officer must route to the National Judicial Council and comply with its signed complaint and verifying-affidavit procedure.",
    "appeal_or_review": "A petition cannot overturn, reverse or vary a judgment, ruling, conviction or sentence. The user must pursue the appropriate appeal, review or court process within applicable deadlines.",
    "lawyer_misconduct": "Professional misconduct allegations against a legal practitioner must route through the Legal Practitioners Disciplinary Committee or authorised Body of Benchers process.",
    "justice_chain_rights": "Unlawful detention, denial of access to counsel, disobedience of court orders and related justice-chain rights violations must route to the National Human Rights Commission.",
    "court_registry": "Missing files, certified-copy delays, record-compilation failures, service failures and registry misconduct must route first to the responsible court or Chief Registrar.",
    "court_delay_first_stage": "A first administrative complaint concerning court delay must route to the relevant Head of Court or Chief Registrar.",
    "court_delay_escalation": "A serious or continuing delay already reported through the court's administrative channel may escalate to the National Judicial Council, subject to its formal complaint rules.",
    "state_judiciary": "State court complaints must use the responsible State Judiciary's verified website, physical registry or Head of Court. State court emails must not be guessed.",
    "maladministration": "The Public Complaints Commission may be included for court-registry or public-administration failures, without interfering with judicial decision-making.",
    "constitutional_independence": "Administrative recipients must not be asked to overturn judgments, direct judicial outcomes or interfere with pending proceedings."
  },
