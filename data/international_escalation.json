  "routing_policy": {
    "active_emergency": "An immediate threat to life or safety must route to the appropriate local emergency or protection authority. International correspondence must not delay emergency action.",
    "domestic_final_escalation": "Ordinary international advocacy should follow appropriate Nigerian domestic escalation unless the selected international mechanism permits urgent action without domestic exhaustion.",
    "human_rights_domestic_route": "Human-rights complaints ordinarily route through the National Human Rights Commission before foreign diplomatic advocacy.",
    "general_domestic_route": "General justice-sector or government escalation ordinarily routes through the Federal Ministry of Justice before foreign advocacy.",
    "united_states": "Verified human-rights advocacy may route to the Tom Lantos Human Rights Commission after relevant domestic steps have been taken.",
    "united_kingdom": "Individual advocacy routes to the FCDO. The House of Commons Foreign Affairs Committee is included only for systemic foreign-policy concerns and does not handle ordinary individual complaints.",
    "european_union": "Advocacy ordinarily routes through the Delegation of the European Union to Nigeria and ECOWAS. DROI may be included for systemic human-rights concerns.",
    "canada": "Verified diplomatic advocacy routes through Global Affairs Canada after relevant domestic escalation.",
    "international_criminal_court": "ICC routing requires screening for alleged genocide, crimes against humanity, war crimes or aggression. Ordinary injustice, appeals and administrative complaints must not route to the ICC.",
    "united_nations_special_procedures": "Credible allegations of past, continuing or potential human-rights violations may route through the official OHCHR Special Procedures submission portal. Domestic exhaustion is not required for this mechanism.",
    "united_nations_treaty_bodies": "Treaty-body complaints require confirmation that Nigeria accepted the relevant individual-complaint procedure and ordinarily require exhaustion of available domestic remedies.",
    "african_commission": "ACHPR communications ordinarily require exhaustion of available local remedies unless unavailable, ineffective or unduly prolonged.",
    "ecowas_court": "An ECOWAS Court matter begins through a formal written application to the Court Registry, not an ordinary advocacy email.",
    "advocacy_limit": "Diplomatic and legislative advocacy is non-binding and is not a court, appeal or enforceable legal remedy.",
    "anti_spam": "Only one tailored submission should be sent through each appropriate verified channel. Bulk, repetitive and indiscriminate international messaging is prohibited."
  },
