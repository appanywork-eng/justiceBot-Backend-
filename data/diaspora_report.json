{
  "sector": "diaspora_report",
  "version": "1.0.0",
  "country": "Nigeria",
  "last_updated": "2026-01-08",
  "scope": "Nigerians in Diaspora — rights violations, illegal detention, trafficking, exploitation, consular protection",
  "purpose": [
    "Help Nigerians abroad report human-rights abuses, illegal detention, trafficking, labour exploitation, scams, and related crimes",
    "Provide correct routing to Nigerian missions abroad, Nigerian authorities, and oversight institutions",
    "Support evidence-based, safe, and legally sound reporting"
  ],

  "routing_rules": {
    "no_invented_contacts": true,
    "max_email_batch": 10,
    "priority_order": [
      "Emergency / immediate danger (local emergency services first)",
      "Nigerian Mission in that country (Embassy/High Commission/Consulate)",
      "NiDCOM (diaspora support)",
      "NHRC (rights violations / unlawful detention / torture / abuse)",
      "NAPTIP (trafficking / forced labour / sexual exploitation)",
      "Federal Ministry of Justice / AGF (serious legal escalation, coordination)"
    ],
    "safety_note": "If the victim is in immediate danger, contact local emergency services first. Do not rely only on email."
  },

  "nigeria_core_support_and_enforcement": [
    {
      "name": "Federal Ministry of Foreign Affairs (Nigeria) — Headquarters",
      "type": "Foreign Affairs / Consular Protection (HQ)",
      "aliases": [
        "Ministry of Foreign Affairs",
        "MFA Nigeria",
        "Nigerian Ministry of Foreign Affairs",
        "Foreign Affairs Nigeria"
      ],
      "contact": {
        "emails": ["info@foreignaffairs.gov.ng"],
        "website": "https://foreignaffairs.gov.ng/"
      },
      "role_summary": [
        "Consular protection oversight",
        "Coordination with Nigerian missions abroad",
        "Diplomatic engagement for detained/abused Nigerians abroad"
      ]
    },
    {
      "name": "Nigerians in Diaspora Commission (NiDCOM)",
      "type": "Diaspora Support / Citizen Assistance",
      "aliases": ["NiDCOM", "Nigerians in Diaspora Commission"],
      "contact": {
        "emails": ["admin@nidcom.gov.ng"],
        "website": "https://nidcom.gov.ng/"
      },
      "role_summary": [
        "Receives diaspora distress reports",
        "Coordinates with missions and Nigerian MDAs",
        "Supports diaspora welfare interventions"
      ]
    },
    {
      "name": "National Human Rights Commission (NHRC)",
      "type": "Human Rights Oversight / Complaint Handling",
      "aliases": ["NHRC", "National Human Rights Commission Nigeria"],
      "contact": {
        "emails": ["info@nhrc.gov.ng"],
        "website": "https://nhrc.gov.ng/"
      },
      "role_summary": [
        "Human-rights complaint intake and intervention",
        "Documentation and escalation of rights violations",
        "Engagement with relevant agencies where applicable"
      ]
    },
    {
      "name": "National Agency for the Prohibition of Trafficking in Persons (NAPTIP)",
      "type": "Anti-Human Trafficking / Exploitation Response",
      "aliases": ["NAPTIP", "Anti-Trafficking Agency Nigeria"],
      "contact": {
        "emails": ["info@naptip.gov.ng"]
      },
      "role_summary": [
        "Trafficking and exploitation reporting",
        "Victim support coordination (where applicable)",
        "Investigation referrals and inter-agency collaboration"
      ]
    },
    {
      "name": "Federal Ministry of Justice (Nigeria) / Office of the Attorney-General of the Federation (AGF)",
      "type": "Justice Sector Coordination / Legal Escalation",
      "aliases": [
        "Federal Ministry of Justice",
        "Ministry of Justice Nigeria",
        "Office of the AGF",
        "Attorney-General of the Federation"
      ],
      "contact": {
        "emails": ["info@justice.gov.ng"],
        "website": "https://www.justice.gov.ng/"
      },
      "role_summary": [
        "Justice-sector coordination",
        "Serious legal escalations and policy-level handling",
        "Interface with prosecutions and legal coordination (as applicable)"
      ]
    }
  ],

