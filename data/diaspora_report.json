  "routing_policy": {
    "immediate_emergency": "Active danger must route first to the relevant host-country emergency service. Ordinary petition generation must be blocked.",
    "trafficking_and_exploitation": "Suspected trafficking, forced labour, deceptive recruitment or passport seizure must route to NAPTIP with the nearest Nigerian mission, NiDCOM and the Foreign Affairs Ministry included where appropriate.",
    "passport_first_stage": "A first passport, renewal, replacement or emergency travel-document request abroad must route through the nearest Nigerian embassy, high commission or consulate.",
    "passport_escalation": "An unresolved passport or immigration-service complaint with a previous reference must route to the Nigeria Immigration Service.",
    "consular_welfare": "Country-specific welfare, detention, hospitalisation, death, evacuation or stranded-person assistance must route first to the nearest Nigerian diplomatic mission.",
    "diaspora_coordination": "General diaspora welfare, coordination and institutional-support reports must route to NiDCOM.",
    "headquarters_consular_support": "The Federal Ministry of Foreign Affairs may support mission-level consular cases or headquarters escalation.",
    "mission_contact_safety": "Mission emails must not be guessed. The official diplomatic-mission directory must be used to identify the responsible mission."
  },
