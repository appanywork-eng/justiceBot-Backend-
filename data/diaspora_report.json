  "evidence_checklist": [
    "Country and city where the incident occurred",
    "Full name and Nigerian citizenship information",
    "Responsible embassy, high commission or consulate where known",
    "Passport application ID or payment reference where relevant",
    "Previous complaint reference and date",
    "Names of employers, recruiters, agents or institutions involved",
    "Chronology of events with dates and locations",
    "Employment contract, recruitment documents or payment evidence",
    "Police, immigration, hospital or detention reference where available",
    "Safe contact details for the affected Nigerian",
    "Details of immediate threats, exploitation or passport seizure"
  ],
  "drafting_safety": {
    "active_emergency_blocks_ordinary_generation": true,
    "suspected_trafficker_not_automatically_copied": true,
    "unsafe_employer_not_automatically_copied": true,
    "mission_email_must_not_be_invented": true,
