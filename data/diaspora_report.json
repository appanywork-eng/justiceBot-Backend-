  "diaspora_report_workflows": [
    {
      "name": "Illegal detention / disappearance / torture / rights abuse",
      "when_to_use": [
        "Unlawful arrest or detention",
        "Passport seized by employer/agent",
        "Detention without access to lawyer/family",
        "Torture/abuse/inhumane treatment",
        "Forced disappearance"
      ],
      "recommended_routing": {
        "to": ["Nigerian Mission in the country"],
        "cc": ["Nigerians in Diaspora Commission (NiDCOM)", "National Human Rights Commission (NHRC)"],
        "optional_cc": ["Federal Ministry of Foreign Affairs (HQ)", "Federal Ministry of Justice / AGF"]
      },
      "must_include": [
        "Full name (as on passport)",
        "Passport number (or a masked version if needed)",
        "Country/city, last known location",
        "Date/time of arrest or disappearance",
        "Arresting authority if known",
        "Detention location if known",
        "Witness details",
        "Family contact number"
      ]
    },
    {
      "name": "Human trafficking / forced labour / sexual exploitation",
      "when_to_use": [
        "Debt bondage",
        "Confiscation of passport/ID by agent",
        "Forced prostitution or sexual exploitation",
        "Forced labour, withheld wages, threats",
        "Smuggling network abuse"
      ],
      "recommended_routing": {
        "to": ["Nigerian Mission in the country"],
        "cc": ["NAPTIP", "NiDCOM", "NHRC"],
        "optional_cc": ["Federal Ministry of Foreign Affairs (HQ)", "Federal Ministry of Justice / AGF"]
      },
      "must_include": [
        "Recruitment/agent details",
        "Travel route and dates",
        "Where and how the victim is being held",
        "Threats/abuse description",
        "Any bank transfer/receipt evidence",
        "Photos/messages/voice notes if safe"
      ]
    },
    {
      "name": "Immigration detention / deportation crisis",
      "when_to_use": [
        "Detained by immigration",
        "Scheduled deportation",
        "Denied consular access",
        "Lost travel documents"
      ],
      "recommended_routing": {
        "to": ["Nigerian Mission in the country"],
        "cc": ["NiDCOM"],
        "optional_cc": ["Federal Ministry of Foreign Affairs (HQ)"]
      },
      "must_include": [
        "Immigration case reference (if any)",
        "Detention center name/address",
        "Court date (if any)",
        "Lawyer details (if any)",
        "Copy/photo of passport/residence permit"
      ]
    }
  ],

  "watchdogs_and_cross_cutting_cc": [
    {
      "name": "Public Complaints Commission (PCC)",
      "type": "Watchdog (Nigeria) — maladministration / poor complaint handling",
      "aliases": ["PCC", "Public Complaints Commission"],
      "note": "Useful if a Nigerian MDA mishandles a diaspora-related case, ignores petitions, or shows maladministration after escalation.",
      "contact": {
        "emails": ["complaint@pcc.gov.ng", "info@pcc.gov.ng"]
      }
    }
  ],

  "routing_keywords": [
    "illegal detention",
    "unlawful arrest",
    "passport seized",
    "human trafficking",
    "sex trafficking",
    "forced labour",
    "wage theft",
    "domestic servitude",
    "kidnapping",
    "torture",
    "abuse",
    "immigration detention",
    "deportation",
    "missing person abroad",
    "diaspora scam",
    "agent fraud",
    "recruitment scam"
  ],

  "evidence_checklist": [
    "Passport biodata page (photo, can be masked)",
    "Entry visa / residence permit (if any)",
    "Flight details / travel route timeline",
    "Agent/recruiter name, number, social handles",
    "Employer details and address (if applicable)",
    "Photos/videos of injuries or location (if safe)",
    "Chat logs / emails / voice notes / threats",
    "Bank transfers / receipts / money trail",
    "Witness names and contacts",
    "Police/immigration reference numbers (if any)"
  ]
}
