  "routing_policy": {
    "regulated_sector_first": "Complaints involving electricity, banking, aviation, telecommunications, healthcare, education or another regulated service must remain in the relevant specialist sector.",
    "voluntary_adr": "Private civil disputes suitable for settlement may first be referred to an appropriate mediation or Multi-Door Courthouse process.",
    "fct_adr": "Suitable FCT disputes route to Abuja Multi-Door Court unless the facts clearly require formal court filing.",
    "lagos_general_mediation": "Suitable Lagos landlord-tenant, debt, family-property and similar disputes may route to the Citizens' Mediation Bureau.",
    "lagos_complex_adr": "Suitable Lagos commercial, partnership and complex contractual disputes may route to Lagos Multi-Door Courthouse.",
    "other_states": "Outside FCT and Lagos, locate the relevant official state ADR institution dynamically through the state judiciary or Ministry of Justice.",
    "court_escalation": "Where mediation is refused, unsuccessful or unsuitable, confirm the correct Small Claims Court, Magistrates' Court or other competent court through the official judiciary.",
    "unknown_location": "Where jurisdiction cannot be established, generate a formal notice to the other party without selecting or guessing an institutional email.",
    "no_pcc": "Do not route an ordinary private civil dispute against an individual, landlord, tenant or private contracting party to the Public Complaints Commission.",
    "legal_limitations": "Do not guarantee jurisdiction, liability, monetary limits, limitation periods or litigation outcomes. These must be confirmed under the applicable state rules."
