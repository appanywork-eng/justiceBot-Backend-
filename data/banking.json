  "routing_rules": {
    "first_complaint": {
      "recipient": "The responsible bank or financial-service provider",
      "delivery": "The provider's official complaints unit, branch, application support, website or verified complaint email",
      "requirement": "Obtain and retain the institution's complaint reference, ticket or written acknowledgement."
    },
    "unresolved_complaint": {
      "recipient": "Central Bank of Nigeria Consumer Protection Department",
      "also_notify": "The responsible financial institution",
      "delivery": "Verified CBN complaint email, official complaint portal or written filing through a CBN branch",
      "applicable_timeline": "Generally two weeks after first complaining to the institution; certain excess-charge and loan complaints may have an applicable thirty-day resolution period.",
      "requirement": "Include evidence of the earlier complaint, its reference, the disputed amount and relevant supporting documents."
    },
    "unknown_institution": {
      "rule": "A financial institution not explicitly listed may still be routed safely using the organisation name supplied by the complainant.",
      "direct_email_rule": "No email may be invented or inferred for an unlisted institution."
    },
    "restricted_routes": [
      "EFCC and the Nigeria Police are not automatically copied on ordinary banking service disputes.",
      "FCCPC, SERVICOM and NHRC are not automatically copied where the complaint falls within the CBN consumer-redress process.",
      "A claim of fraud does not justify inventing criminal liability or declaring a person guilty.",
      "The petition must not contain a PIN, password, one-time password, full card security code or internet-banking credential."
    ]
  },
