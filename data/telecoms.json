  "routing_rules": {
    "first_complaint": {
      "recipient": "Responsible telecommunications operator",
      "delivery": "Verified operator complaint email, contact page, call centre or service centre",
      "requirement": "The consumer should obtain and retain an operator complaint ticket or reference."
    },
    "unresolved_complaint": {
      "recipient": "Nigerian Communications Commission (NCC)",
      "delivery": "Official NCC consumer-complaint form or toll-free consumer line 622",
      "also_notify": "Responsible telecommunications operator",
      "requirement": "Include the operator complaint reference and relevant evidence where available."
    },
    "restricted_routes": [
      "The supervising ministry is not an ordinary first-stage consumer complaint route.",
      "Legislative bodies are not automatically copied on ordinary telecommunications complaints.",
      "Immigration authorities are not telecommunications complaint bodies.",
      "NHRC or other rights bodies may be considered only where the facts independently raise a human-rights issue."
    ],
    "verified_live_metadata": "Live routing exposes only officially verified operator emails, telephone numbers, portals, addresses and source URLs.",
    "unknown_provider": "Where the provider name is user-supplied but not present in the verified registry, generate the complaint without exposing or guessing any email address.",
    "ncc_escalation": "The NCC escalation route uses the official consumer complaint portal, complaint-management system and consumer telephone channels. It does not expose an invented NCC complaint email."
  },
