  "evidence_checklist": [
    "Full names, roles or official positions of persons involved",
    "Responsible ministry, department, agency or organisation",
    "Factual chronology with dates and locations",
    "Amounts and transaction references where relevant",
    "Contract, tender or procurement details where relevant",
    "Invoices, receipts, award letters, payment records or audit documents",
    "Emails, messages, photographs or other supporting records",
    "Witness information where safely available",
    "Previous complaint acknowledgement or reference number",
    "Details of threats or retaliation where applicable"
  ],
  "drafting_safety": {
    "allegations_must_not_be_presented_as_proven_facts": true,
    "defamatory_or_insulting_language_prohibited": true,
    "unnecessary_personal_financial_data_prohibited": true,
    "passwords_and_account_credentials_prohibited": true,
    "alleged_subject_not_automatically_copied": true,
    "reporter_safety_must_be_considered": true
  },
  "security_rules": {
    "official_sources_only": true,
    "unverified_contacts_gated": true,
    "active_emergency_blocks_generation": true,
    "preserve_evidence_only_when_safe": true
  }
