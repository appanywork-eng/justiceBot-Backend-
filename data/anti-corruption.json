  "routing_policy": {
    "allegation_specific_routing": true,
    "indiscriminate_mass_routing_prohibited": true,
    "financial_crime": "Route suspected economic crime, money laundering, diversion, embezzlement and serious financial fraud to EFCC.",
    "bribery_and_public_corruption": "Route alleged bribery, gratification, abuse of office and public-sector corrupt practices to ICPC.",
    "code_of_conduct": "Route asset-declaration, conflict-of-interest and public-officer conduct matters to CCB.",
    "procurement": "Route procurement-process and public-contract compliance petitions to BPP.",
    "combined_allegations": "Select the authority with the principal jurisdiction and include another authority only where the facts independently engage its mandate.",
    "maladministration": "PCC may be copied where an authority or public institution refuses to act, suppresses a complaint or commits administrative injustice.",
    "retaliation": "NHRC may be included where whistleblower retaliation, threats or connected rights violations are alleged.",
    "immediate_danger": "Ordinary petition generation must be blocked where the reporter describes an active emergency or immediate threat to life."
  },
