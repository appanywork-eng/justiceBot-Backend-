  "routing_policy": {
    "active_emergency": "An ongoing attack, kidnapping or immediate threat must route to the nearest police station or appropriate emergency security agency. Ordinary petition generation must be blocked.",
    "crime_report": "Kidnapping, armed robbery, missing-person and other crime reports must first be made to the relevant State Police Command or nearest police station.",
    "serious_rights_violation": "Unlawful detention, torture, forced confession, extrajudicial killing and other serious security-related rights abuses must route to the National Human Rights Commission.",
    "police_discipline": "Police extortion, bribery, harassment, illegal checkpoints and disciplinary complaints must route to the Police Service Commission.",
    "correctional_complaint": "Inmate welfare, custodial-centre conditions and correctional-officer complaints must route to the Nigerian Correctional Service.",
    "civil_defence_complaint": "NSCDC service, officer-conduct and incident complaints must route through the Corps' verified official channels.",
    "immigration_complaint": "Immigration, border-control and unresolved passport-service complaints must route through the Nigeria Immigration Service's verified complaint channels.",
    "military_complaint": "Army, Navy and Air Force complaints must route only through their verified headquarters, call-centre, contact-form or ombudsman channels.",
    "agency_first": "Ordinary service complaints should first be submitted to the responsible security agency or command.",
    "internal_escalation": "Unresolved complaints with an earlier reference should be escalated to the agency headquarters, inspectorate, SERVICOM or complaint authority.",
    "contact_safety": "Police-command and military email addresses must not be guessed. Official directories or portal-only channels must be used where no verified complaint email exists."
  },
