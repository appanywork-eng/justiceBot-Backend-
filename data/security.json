  "evidence_checklist": [
    "Incident date, time and exact location",
    "Name of the responsible security agency",
    "Names, ranks, service numbers or descriptions of officers where known",
    "Police station, command, formation, unit or custodial centre involved",
    "Arrest, detention, bail or incident-reference details",
    "Previous complaint acknowledgement or reference number",
    "Photographs, videos, recordings or documents obtained lawfully",
    "Medical reports where injury or torture is alleged",
    "Names and safe contact details of witnesses",
    "Details of property seized, damaged or withheld",
    "Court, police, immigration or correctional documents",
    "Immediate safety risks to the complainant, victim or witnesses"
  ],
