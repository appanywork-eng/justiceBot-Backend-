  "routing_keywords": [
    "hospital negligence",
    "treatment refusal",
    "hmo denial",
    "counterfeit drugs",
    "expired drugs",
    "lab result withheld",
    "equipment failure",
    "emergency care refusal",
    "radiology abuse",
    "clinic extortion",
    "accident victims refusal"
